                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onProperty sphn:hasDateTime ] ) ],
        sphn:SPHNConcept ;
    owl:equivalentClass snomed:305056002 ;
    skos:definition "admission of a patient to the healthcare provider institute" .

