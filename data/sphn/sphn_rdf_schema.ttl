ng sphn:SemanticMapping sphn:SequencingAnalysis sphn:SequencingAssay sphn:SourceData sphn:Substance sphn:TherapeuticArea sphn:TimeSeriesDataFile sphn:TobaccoExposure sphn:TransplantPresence sphn:TumorGradeAssessmentEvent sphn:TumorSpecimen sphn:TumorStageAssessmentEvent sphn:VariantDescriptor sphn:XRayImagingSeries ) ] ;
