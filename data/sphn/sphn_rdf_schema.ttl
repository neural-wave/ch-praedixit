            owl:unionOf ( sphn:Allergy sphn:SPHNConcept ) ] ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf sphn:hasDateTime ;
    skos:definition "datetime of the last reaction" ;
