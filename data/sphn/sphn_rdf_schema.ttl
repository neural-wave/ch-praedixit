                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( dcm:NM dcm:OP dcm:ECG dcm:US dcm:GM sphn:Code dcm:TG dcm:BI dcm:LS dcm:DG dcm:MG dcm:CR dcm:OSS dcm:OCT dcm:POS dcm:IVOCT dcm:EOG dcm:RF dcm:DX dcm:DMS dcm:RESP dcm:EEG dcm:KER dcm:CT dcm:OAM snomed:360037004 dcm:ES dcm:PX dcm:CFM dcm:PT dcm:IO dcm:RTIMAGE dcm:VA dcm:BDUS dcm:RG dcm:XC dcm:OPT dcm:SM dcm:OPTENF dcm:PA dcm:MR sphn:Terminology dcm:EPS dcm:HD dcm:IVUS dcm:LEN dcm:XA dcm:OPV dcm:AR dcm:OPTBSV dcm:OPM dcm:SRF dcm:BMD dcm:EMG ) ] ] ) ],
        sphn:SPHNConcept ;
