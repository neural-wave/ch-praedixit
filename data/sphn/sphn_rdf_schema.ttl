    rdfs:domain [ a owl:Class ;
            owl:unionOf ( sphn:Age sphn:SPHNConcept sphn:AntimicrobialSusceptibilityResult sphn:AssessmentResult sphn:BodyHeight sphn:BodyMassIndex sphn:BodySurfaceArea sphn:BodyTemperature sphn:BodyWeight sphn:CardiacIndex sphn:CardiacOutput sphn:Circumference sphn:ContrastAgent sphn:ContrastAgentActiveIngredient sphn:Drug sphn:Exposure sphn:FluidBalance sphn:FractionOfInspiredOxygen sphn:GestationalAgeAtBirth sphn:HeartRate sphn:LabResult sphn:MicrobiologyBiomoleculePresenceResult sphn:MicrobiologyMicroscopyResult sphn:MicroorganismIdentificationResult sphn:NutritionalProduct sphn:OxygenSaturation sphn:QualityControlMetric sphn:Radioactivity sphn:Radionuclide sphn:Radiopharmaceutical sphn:ReferenceValue sphn:RespiratoryRate sphn:Substance sphn:TobaccoExposure sphn:TumorGradeAssessmentResult sphn:TumorStageAssessmentResult sphn:AllergyEpisode sphn:Birth sphn:BloodPressure sphn:ComputedTomographyImagingSeries sphn:ContrastAgentAdministrationEvent sphn:CopyNumberVariation sphn:DataCompressionAlgorithm sphn:DrugAdministrationEvent sphn:DrugPrescription sphn:ElectrocardiographicProcedure sphn:FlowProfileInterval sphn:ImageDimensions sphn:ImagingSeries sphn:LibraryPreparation sphn:MagneticResonanceImagingSeries sphn:NucleotideSequence sphn:OxygenAdministrationEvent sphn:PixelDimensions sphn:PositronEmissionTomographyImagingSeries sphn:RadiopharmaceuticalAdministrationEvent sphn:RadiotherapyProcedure sphn:Range sphn:ReferenceRange sphn:SequencingAssay sphn:SequencingRun sphn:SwissSocioEconomicPosition sphn:TimePattern sphn:TimeSeriesDataFile sphn:TumorSpecimen sphn:XRayImagingSeries ) ] ;
