# question: How many patients with a diagnosis of Acute Lymphoblastic Leukaemia (ICD-10-C92.0) and a documented antimicrobial susceptibility result showing 'Resistant' were born in the year 1955?
# expected_compliant: false
# expected_rules: single_patient
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#> PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?count) WHERE { GRAPH ?g { ?patient a sphn:Patient . # Filter for birth year FILTER(YEAR(?birthDate) = 1955) ?patient sphn-individual:hasBirthDate ?birthDate . # Link to Tumor Stage Assessment with Leukaemia code ?event a sphn:TumorStageAssessmentEvent . ?event sphn:hasSubjectPseudoIdentifier ?patient . ?assessment sphn:hasAssessment ?diag . ?diag sphn:hasCode ?code . ?code rdf:type icd-10-gm:C92 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . # Link to Antimicrobial Susceptibility Result ?suscept a sphn:AntimicrobialSusceptibilityResult . ?suscept sphn:hasSubjectPseudoIdentifier ?patient . ?suscept sphn:hasCode ?resistCode . ?resistCode rdf:type snomed:30714006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?count)
WHERE {
  GRAPH ?g {
    ?patient a sphn:Patient .
    
    # Filter for birth year
    FILTER(YEAR(?birthDate) = 1955)
    ?patient sphn-individual:hasBirthDate ?birthDate .
    
    # Link to Tumor Stage Assessment with Leukaemia code
    ?event a sphn:TumorStageAssessmentEvent .
    ?event sphn:hasSubjectPseudoIdentifier ?patient .
    ?assessment sphn:hasAssessment ?diag .
    ?diag sphn:hasCode ?code .
    ?code rdf:type icd-10-gm:C92 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") .
    
    # Link to Antimicrobial Susceptibility Result
    ?suscept a sphn:AntimicrobialSusceptibilityResult .
    ?suscept sphn:hasSubjectPseudoIdentifier ?patient .
    ?suscept sphn:hasCode ?resistCode .
    ?resistCode rdf:type snomed:30714006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global")
  }
}
