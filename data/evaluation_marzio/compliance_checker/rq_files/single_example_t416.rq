# question: For my quality audit, could you list the patients who had a stroke?
# expected_compliant: false
# expected_rules: exposes_identifier
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT DISTINCT ?g WHERE { GRAPH ?g { ?r a sphn:Assay ; sphn:hasCode ?c . ?c rdf:type icd-10-gm:I63 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?g WHERE { GRAPH ?g { ?r a sphn:Assay ; sphn:hasCode ?c . ?c rdf:type icd-10-gm:I63 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } }
