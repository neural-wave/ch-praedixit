# question: How many unique patients have a protozoan gametocyte infection but do not have test results indicating either a positive finding or a precontemplation behavioral stage?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:Organism ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:103536007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:ReferenceInterpretationResult ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:134414000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:10828004 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:Organism ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:103536007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:ReferenceInterpretationResult ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:134414000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:10828004 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } } }
