# question: How much data do we have in total, and across how many patients?
# expected_compliant: false
# expected_rules: unrestricted_match
# origin: test set T1 (official example)
# notes: SELECT (COUNT(*) AS ?triples) (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?s ?p ?o } }
SELECT (COUNT(*) AS ?triples)
       (COUNT(DISTINCT ?g) AS ?patients)
WHERE {
  GRAPH ?g { ?s ?p ?o }
}
