# question: Show me the top 10 kidney failure codes on bills, with patient counts.
# expected_compliant: true
# expected_rules: none
# origin: dev
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT ?code (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c rdf:type icd-10-gm:N17-N19 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?c a ?concept . } FILTER(STRSTARTS(STR(?concept), STR(icd-10-gm:))) BIND(REPLACE(STR(?concept), "^.*/", "") AS ?code) } GROUP BY ?code ORDER BY DESC(?patients) LIMIT 10
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?code (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c rdf:type icd-10-gm:N17-N19 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?c a ?concept . } FILTER(STRSTARTS(STR(?concept), STR(icd-10-gm:))) BIND(REPLACE(STR(?concept), "^.*/", "") AS ?code) } GROUP BY ?code ORDER BY DESC(?patients) LIMIT 10
