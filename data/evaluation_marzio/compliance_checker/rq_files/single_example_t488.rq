# question: Retrieve the specific count of library prep code occurrences for patient ID 5665.
# expected_compliant: false
# expected_rules: single_patient
# origin: dev
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX efo: <http://www.ebi.ac.uk/efo/EFO_> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH <http://example.org/graph/mock_data-1_5665> { ?r a sphn:LibraryPreparation ; sphn:hasCode ?r_c . { ?r_c rdf:type efo:0010714 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type efo:0030074 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } ?r sphn:hasStartDateTime ?date . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX efo: <http://www.ebi.ac.uk/efo/EFO_>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH <http://example.org/graph/mock_data-1_5665> { ?r a sphn:LibraryPreparation ; sphn:hasCode ?r_c . { ?r_c rdf:type efo:0010714 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type efo:0030074 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } ?r sphn:hasStartDateTime ?date . } }
