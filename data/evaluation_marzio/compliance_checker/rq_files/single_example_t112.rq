# question: I am studying the epidemiology of acute leukemias coded as C91. Can you provide the total number of patients diagnosed with this condition, along with the average, minimum, and maximum laboratory result values recorded for these cases, expressed in units of 10^3?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/> SELECT (COUNT(DISTINCT ?g) AS ?patients) (ROUND(10 * AVG(?v)) / 10 AS ?avg) (MIN(?v) AS ?min) (MAX(?v) AS ?max) WHERE { GRAPH ?g { ?r a sphn:LabResult ; sphn:hasQuantity ?q . ?q sphn:hasValue ?v ; sphn:hasUnit/sphn:hasCode ?u . ?u a ucum:10exp3 . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (ROUND(10 * AVG(?v)) / 10 AS ?avg) (MIN(?v) AS ?min) (MAX(?v) AS ?max) WHERE { GRAPH ?g { ?r a sphn:LabResult ; sphn:hasQuantity ?q . ?q sphn:hasValue ?v ; sphn:hasUnit/sphn:hasCode ?u . ?u a ucum:10exp3 . } }
