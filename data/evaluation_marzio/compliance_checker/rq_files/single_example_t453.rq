# question: how many c91 substance values are below 3500 between 3500 and 6700 and over 6700
# expected_compliant: true
# expected_rules: none
# origin: dev
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/> SELECT (SUM(IF(?v < 3500.0, 1, 0)) AS ?low) (SUM(IF(?v >= 3500.0 && ?v < 6700.0, 1, 0)) AS ?middle) (SUM(IF(?v >= 6700.0, 1, 0)) AS ?high) WHERE { GRAPH ?g { ?r a sphn:Substance ; sphn:hasQuantity ?q . ?q sphn:hasValue ?v ; sphn:hasUnit/sphn:hasCode ?u . ?u a ucum:H . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/>
SELECT (SUM(IF(?v < 3500.0, 1, 0)) AS ?low) (SUM(IF(?v >= 3500.0 && ?v < 6700.0, 1, 0)) AS ?middle) (SUM(IF(?v >= 6700.0, 1, 0)) AS ?high) WHERE { GRAPH ?g { ?r a sphn:Substance ; sphn:hasQuantity ?q . ?q sphn:hasValue ?v ; sphn:hasUnit/sphn:hasCode ?u . ?u a ucum:H . } }
