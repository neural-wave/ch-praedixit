# question: How many unique male patients with malignant tumors of the genital organs (ICD-10 C60-C63), breast cancer (ICD-10 C50.9), or cholera (ICD-10 A00.0) were treated in the hospital without ever requiring mechanical organ support or extracorporeal albumin hemodialysis?
# expected_compliant: true
# expected_rules: none
# origin: dev
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:OncologyDiagnosis ; sphn:hasCode ?a_c . { ?a_c rdf:type icd-10-gm:C60-C63 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type icd-10-gm:C50.9 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type icd-10-gm:A00.0 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:OrganSupport ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:1222606000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:427053002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:OncologyDiagnosis ; sphn:hasCode ?a_c . { ?a_c rdf:type icd-10-gm:C60-C63 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type icd-10-gm:C50.9 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type icd-10-gm:A00.0 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:OrganSupport ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:1222606000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:427053002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } } }
