SELECT (COUNT(DISTINCT ?a) AS ?records) WHERE { GRAPH ?g { ?a a sphn:ResuscitationDirective ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:304252001 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:MicrobiologyBiomoleculePresenceResult ; sphn:hasCode ?b_c . ?b_c rdf:type snomed:260385009 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?a sphn:hasSubjectPseudoIdentifier ?p . ?p sphn:hasIdentifier "ID-10389580000044" . } }
