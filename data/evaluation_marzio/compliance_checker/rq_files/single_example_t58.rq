# question: Calculate the percentage of patients with SNOMED CT codes 113355002 (Chromosome pair 3) or 66933007 (Chromosome pair 14) who also have SNOMED CT code 13526007 (Chromosome pair 9) or 72837006 (Sex chromosome X). Return the group size, the number of patients with both criteria, and the percentage.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients_b) (COUNT(DISTINCT ?ab) AS ?patients_a_and_b) (ROUND(1000.0 * COUNT(DISTINCT ?ab) / COUNT(DISTINCT ?g)) / 10 AS ?pct) WHERE { GRAPH ?g { ?b a sphn:Chromosome ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:113355002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:66933007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } OPTIONAL { GRAPH ?g { ?a a sphn:Chromosome ; sphn:hasCode ?a_c . { ?a_c rdf:type snomed:13526007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type snomed:72837006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } BIND(?g AS ?ab) } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients_b) (COUNT(DISTINCT ?ab) AS ?patients_a_and_b) (ROUND(1000.0 * COUNT(DISTINCT ?ab) / COUNT(DISTINCT ?g)) / 10 AS ?pct) WHERE { GRAPH ?g { ?b a sphn:Chromosome ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:113355002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:66933007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } OPTIONAL { GRAPH ?g { ?a a sphn:Chromosome ; sphn:hasCode ?a_c . { ?a_c rdf:type snomed:13526007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type snomed:72837006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } BIND(?g AS ?ab) } }
