# question: I am analyzing the specificity of laboratory testing documentation to ensure accurate anatomical reporting. Could you compute the number of distinct patients for whom we have at least one lab test recorded with an Ingredient qualitative strength code (SNOMED CT 1149484003) and simultaneously at least one laterality specification coded as SNOMED CT Concept (SNOMED CT 138875005), Unilateral (SNOMED CT 66459002), or Right (SNOMED CT 24028007)?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:LabTest ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:1149484003 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:Laterality ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:138875005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:66459002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:24028007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:LabTest ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:1149484003 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:Laterality ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:138875005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:66459002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:24028007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
