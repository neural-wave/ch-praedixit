# question: Our research team needs to know the total count of unique patients who have had any tumor grade assessment recorded specifically in millimeters of aluminum.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:TumorGradeAssessmentResult ; sphn:hasCode ?r_c . ?r_c rdf:type snomed:229050008 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:TumorGradeAssessmentResult ; sphn:hasCode ?r_c . ?r_c rdf:type snomed:229050008 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
