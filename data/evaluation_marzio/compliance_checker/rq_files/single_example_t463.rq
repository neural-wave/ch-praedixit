# question: Calculate the volume and proportion of principal CHOP 00 interventions.
# expected_compliant: true
# expected_rules: none
# origin: dev
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#> PREFIX chop: <https://biomedit.ch/rdf/sphn-resource/chop/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?principal) AS ?patients_principal) (ROUND(1000.0 * COUNT(DISTINCT ?principal) / COUNT(DISTINCT ?g)) / 10 AS ?principal_pct) WHERE { GRAPH ?g { ?r a sphn:BilledProcedure ; sphn:hasCode ?r_c . ?r_c rdf:type chop:00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } OPTIONAL { GRAPH ?g { ?r sphn:hasRank sphn-individual:Principal . } BIND(?g AS ?principal) } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX chop: <https://biomedit.ch/rdf/sphn-resource/chop/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?principal) AS ?patients_principal) (ROUND(1000.0 * COUNT(DISTINCT ?principal) / COUNT(DISTINCT ?g)) / 10 AS ?principal_pct) WHERE { GRAPH ?g { ?r a sphn:BilledProcedure ; sphn:hasCode ?r_c . ?r_c rdf:type chop:00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } OPTIONAL { GRAPH ?g { ?r sphn:hasRank sphn-individual:Principal . } BIND(?g AS ?principal) } }
