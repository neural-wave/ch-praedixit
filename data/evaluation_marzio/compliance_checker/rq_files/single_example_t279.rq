# question: Show me which patients had radiation tests and stereotactic or brachy treatments, including one example.
# expected_compliant: false
# expected_rules: exposes_identifier
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) (SAMPLE(?g) AS ?example_patient) WHERE { GRAPH ?g { ?a a sphn:MicrobiologyBiomoleculePresenceLabTest ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:282251006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:RadiotherapyProcedure ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:115959002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:152198000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (SAMPLE(?g) AS ?example_patient) WHERE { GRAPH ?g { ?a a sphn:MicrobiologyBiomoleculePresenceLabTest ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:282251006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:RadiotherapyProcedure ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:115959002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:152198000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
