PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?when ?end ?start WHERE { GRAPH ?g { ?r a sphn:BloodPressureMeasurement . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . ?r sphn:hasStartDateTime ?when . } } ORDER BY ?when
