# question: List each C91 nutrition record's start and end times
# expected_compliant: false
# expected_rules: not_aggregated
# origin: dev
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> SELECT ?when ?end ?start WHERE { GRAPH ?g { ?r a sphn:NutritionIntake . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . ?r sphn:hasEndDateTime ?when . } } ORDER BY ?when
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?when ?end ?start WHERE { GRAPH ?g { ?r a sphn:NutritionIntake . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . ?r sphn:hasEndDateTime ?when . } } ORDER BY ?when
