# question: Compte distinct patients ayant au moins un code d’intervenant paternal half brother (SNOMED CT 719762005, sous‑codes inclus) et au moins un allergène codé pounds sterling par jour (qualificateur valeur) (SNOMED CT 224918003, sous‑codes inclus) ou SNOMED RT+CTV3 (SNOMED CT 138875005, sous‑codes inclus)
# expected_compliant: true
# expected_rules: none
# origin: test set T3 (worded by the other model)
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:Performer ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:719762005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:Allergen ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:224918003 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:138875005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:Performer ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:719762005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:Allergen ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:224918003 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:138875005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
