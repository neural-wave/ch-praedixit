# question: Quel est le nombre de patients distincts qui ont au moins un résultat de sensibilité aux antimicrobiens codé comme Résistant selon le code SNOMED CT 30714006 ?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> PREFIX snomed: <http://snomed.info/id/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:AntimicrobialSusceptibilityResult ; sphn:hasCode ?r_c . ?r_c rdf:type snomed:30714006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:AntimicrobialSusceptibilityResult ; sphn:hasCode ?r_c . ?r_c rdf:type snomed:30714006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
