# question: what is the count of records and patiens for every transplan graft type code eg c91
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#> SELECT ?value (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:Transplant ; sphn:hasGraftTypeCode ?v_c . ?v_c a ?v . } BIND(REPLACE(STR(?v), "^.*/", "") AS ?value) } GROUP BY ?value ORDER BY DESC(?records)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?value (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:Transplant ; sphn:hasGraftTypeCode ?v_c . ?v_c a ?v . } BIND(REPLACE(STR(?v), "^.*/", "") AS ?value) } GROUP BY ?value ORDER BY DESC(?records)
