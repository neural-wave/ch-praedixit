# question: I need to understand the distribution of C91 data releases. For the subset of patients who have at least one such record, please provide the total number of patients, along with the average, minimum, and maximum count of C91 records for each.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(*) AS ?patients) (ROUND(10 * AVG(?n)) / 10 AS ?avg_per_patient) (MIN(?n) AS ?min_per_patient) (MAX(?n) AS ?max_per_patient) WHERE { { SELECT ?g (COUNT(DISTINCT ?r) AS ?n) WHERE { GRAPH ?g { ?r a sphn:DataRelease . } } GROUP BY ?g } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(*) AS ?patients) (ROUND(10 * AVG(?n)) / 10 AS ?avg_per_patient) (MIN(?n) AS ?min_per_patient) (MAX(?n) AS ?max_per_patient) WHERE { { SELECT ?g (COUNT(DISTINCT ?r) AS ?n) WHERE { GRAPH ?g { ?r a sphn:DataRelease . } } GROUP BY ?g } }
