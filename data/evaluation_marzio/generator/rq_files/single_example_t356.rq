# question: Show me the patient IDs for resuscitation status
# expected_compliant: false
# expected_rules: exposes_identifier
# origin: train
# notes: SELECT DISTINCT ?id WHERE { GRAPH ?g { ?r a sphn:ResuscitationDirective ; sphn:hasCode ?r_c . { ?r_c isa snomed:304252001 } UNION { ?r_c isa snomed:365870005 } ?r sphn:hasRecordDateTime ?date . ?r sphn:hasSubjectPseudoIdentifier ?p . ?p sphn:hasIdentifier ?id . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?id WHERE { GRAPH ?g { ?r a sphn:ResuscitationDirective ; sphn:hasCode ?r_c . { ?r_c rdf:type snomed:304252001 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type snomed:365870005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } ?r sphn:hasRecordDateTime ?date . ?r sphn:hasSubjectPseudoIdentifier ?p . ?p sphn:hasIdentifier ?id . } }
