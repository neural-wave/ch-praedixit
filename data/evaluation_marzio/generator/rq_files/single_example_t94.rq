# question: How many distinct patients have a microorganism identified as absent but lack any recorded tumor grade assessment including WHO or Fuhrman systems?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:MicroorganismIdentificationResult ; sphn:hasCode ?a_c . ?a_c isa snomed:2667000 . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:TumorGradeAssessment ; sphn:hasCode ?b_c . { ?b_c isa snomed:1290301002 } UNION { ?b_c isa snomed:277460003 } UNION { ?b_c isa snomed:396192007 } } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:MicroorganismIdentificationResult ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:2667000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:TumorGradeAssessment ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:1290301002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:277460003 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:396192007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } } }
