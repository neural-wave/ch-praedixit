# question: Wie viele Patienten haben einen Vitalstatus von 'Lost to follow-up' (SNOMED CT 399307001), 'Alive' (SNOMED CT 438949009) oder SNOMED RT+CTV3 (138875005)?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:VitalStatus ; sphn:hasCode ?r_c . { ?r_c isa snomed:399307001 } UNION { ?r_c isa snomed:438949009 } UNION { ?r_c isa snomed:138875005 } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:VitalStatus ; sphn:hasCode ?r_c . { ?r_c rdf:type snomed:399307001 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type snomed:438949009 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type snomed:138875005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
