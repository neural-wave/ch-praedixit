# question: For the purpose of evaluating antimicrobial resistance patterns within our patient cohort, could you please calculate the total number of unique individuals who have been documented in the system as having at least one isolate or culture result explicitly classified under the SNOMED CT code 30714006, indicating a Resistant phenotype?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:AntimicrobialSusceptibilityResult ; sphn:hasCode ?r_c . ?r_c isa snomed:30714006 . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?r a sphn:AntimicrobialSusceptibilityResult ; sphn:hasCode ?r_c . ?r_c rdf:type snomed:30714006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
