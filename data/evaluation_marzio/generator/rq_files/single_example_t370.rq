# question: combien de patients ont germ test et qui sont ils ex c91
# expected_compliant: false
# expected_rules: exposes_identifier
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) (SAMPLE(?g) AS ?example_patient) WHERE { GRAPH ?g { ?r a sphn:MicroorganismIdentificationResult . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (SAMPLE(?g) AS ?example_patient) WHERE { GRAPH ?g { ?r a sphn:MicroorganismIdentificationResult . } }
