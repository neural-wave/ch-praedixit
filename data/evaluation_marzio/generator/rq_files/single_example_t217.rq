# question: How many blood cancer cases had radiotherapy each year?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT ?year (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:RadiotherapyProcedure . ?r sphn:hasEndDateTime ?date . } BIND(YEAR(?date) AS ?year) } GROUP BY ?year ORDER BY ?year
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?year (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:RadiotherapyProcedure . ?r sphn:hasEndDateTime ?date . } BIND(YEAR(?date) AS ?year) } GROUP BY ?year ORDER BY ?year
