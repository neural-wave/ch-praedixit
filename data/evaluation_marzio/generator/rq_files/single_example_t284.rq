# question: For patient 9272, how many records match a geographic location of Namibia or Turkmenistan but lack any microorganism identification result coded as Present?
# expected_compliant: false
# expected_rules: single_patient
# origin: train
# notes: SELECT (COUNT(DISTINCT ?a) AS ?records) WHERE { GRAPH <http://example.org/graph/mock_data-1_9272> { ?a a sphn:Country ; sphn:hasCode ?a_c . { ?a_c isa snomed:223545002 } UNION { ?a_c isa snomed:223578009 } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?a) AS ?records) WHERE { GRAPH <http://example.org/graph/mock_data-1_9272> { ?a a sphn:Country ; sphn:hasCode ?a_c . { ?a_c rdf:type snomed:223545002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?a_c rdf:type snomed:223578009 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
