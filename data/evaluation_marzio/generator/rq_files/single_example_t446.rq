# question: Ich möchte verstehen, wie viele Versicherungseinträge und verschiedene Personen hinter jedem Versicherungsstatus stecken, um die Verteilung zu sehen.
# expected_compliant: true
# expected_rules: none
# origin: dev
# notes: SELECT ?value (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:InsuranceStatus ; sphn:hasCoverageType ?v . } BIND(STRAFTER(STR(?v), "#") AS ?value) } GROUP BY ?value ORDER BY DESC(?records)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?value (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:InsuranceStatus ; sphn:hasCoverageType ?v . } BIND(STRAFTER(STR(?v), "#") AS ?value) } GROUP BY ?value ORDER BY DESC(?records)
