# question: Is there any patient with a tumor stage assessment result?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?count) WHERE { GRAPH ?g { ?r a sphn:TumorStageAssessmentResult } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(DISTINCT ?g) AS ?count) WHERE { GRAPH ?g { ?r a sphn:TumorStageAssessmentResult } }
