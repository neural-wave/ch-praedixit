# question: Count patients with radiation exposure lab tests and stereotactic radiosurgery or brachytherapy procedures.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:MicrobiologyBiomoleculePresenceLabTest ; sphn:hasCode ?a_c . ?a_c isa snomed:282251006 . ?b a sphn:RadiotherapyProcedure ; sphn:hasCode ?b_c . { ?b_c isa snomed:115959002 } UNION { ?b_c isa snomed:152198000 } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:MicrobiologyBiomoleculePresenceLabTest ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:282251006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:RadiotherapyProcedure ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:115959002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:152198000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
