# question: Show me the start dates for every C91 record
# expected_compliant: false
# expected_rules: not_aggregated
# origin: train
# notes: SELECT ?when WHERE { GRAPH ?g { ?r a sphn:LibraryPreparation . ?r sphn:hasStartDateTime ?when . } } ORDER BY ?when
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?when WHERE { GRAPH ?g { ?r a sphn:LibraryPreparation . ?r sphn:hasStartDateTime ?when . } } ORDER BY ?when
