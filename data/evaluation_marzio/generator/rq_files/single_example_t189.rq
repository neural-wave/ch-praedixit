# question: We require a statistical breakdown for the epidemiological report: please calculate the total number of patients coded with either Cholera due to Vibrio cholerae O1, Biovar eltor (ICD-10-GM A00.1) or Low back pain (ICD-10-GM M54), identify the count where these were the principal diagnosis, and provide the percentage of principal diagnoses relative to the total cohort.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?principal) AS ?patients_principal) (ROUND(1000.0 * COUNT(DISTINCT ?principal) / COUNT(DISTINCT ?g)) / 10 AS ?principal_pct) WHERE { GRAPH ?g { ?r a sphn:BilledDiagnosis ; sphn:hasCode ?r_c . { ?r_c isa icd-10-gm:A00.1 } UNION { ?r_c isa icd-10-gm:M54 } } OPTIONAL { GRAPH ?g { ?r sphn:hasRank sphn-individual:Principal . } BIND(?g AS ?principal) } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?principal) AS ?patients_principal) (ROUND(1000.0 * COUNT(DISTINCT ?principal) / COUNT(DISTINCT ?g)) / 10 AS ?principal_pct) WHERE { GRAPH ?g { ?r a sphn:BilledDiagnosis ; sphn:hasCode ?r_c . { ?r_c rdf:type icd-10-gm:A00.1 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type icd-10-gm:M54 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } OPTIONAL { GRAPH ?g { ?r sphn:hasRank sphn-individual:Principal . } BIND(?g AS ?principal) } }
