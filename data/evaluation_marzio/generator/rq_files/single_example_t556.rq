# question: Can you pull the count of matching records for just patient 1037085 on oxygen saturation measurement (C91)? I need to know how many instances exist for this specific individual.
# expected_compliant: false
# expected_rules: single_patient
# origin: test set T3 (worded by the other model)
# notes: SELECT (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH <http://example.org/graph/gen_mock_data-1_1037085> { ?r a sphn:OxygenSaturationMeasurement . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH <http://example.org/graph/gen_mock_data-1_1037085> { ?r a sphn:OxygenSaturationMeasurement . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . } }
