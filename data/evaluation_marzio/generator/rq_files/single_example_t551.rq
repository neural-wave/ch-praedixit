# question: give me the ids for patients with chromosome anomaly 138875005 and divorced status 20295000
# expected_compliant: false
# expected_rules: exposes_identifier
# origin: test set T3 (worded by the other model)
# notes: SELECT DISTINCT ?id WHERE { GRAPH ?g { ?a a sphn:Chromosome ; sphn:hasCode ?a_c . ?a_c isa snomed:138875005 . ?b a sphn:CivilStatus ; sphn:hasCode ?b_c . ?b_c isa snomed:20295000 . ?a sphn:hasSubjectPseudoIdentifier ?p . ?p sphn:hasIdentifier ?id . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?id WHERE { GRAPH ?g { ?a a sphn:Chromosome ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:138875005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?b a sphn:CivilStatus ; sphn:hasCode ?b_c . ?b_c rdf:type snomed:20295000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?a sphn:hasSubjectPseudoIdentifier ?p . ?p sphn:hasIdentifier ?id . } }
