# question: Provide patient count and drug Gy statistics for current quarter.
# expected_compliant: true
# expected_rules: none
# origin: test set T3 (worded by the other model)
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) (ROUND(10 * AVG(?v)) / 10 AS ?avg) (MIN(?v) AS ?min) (MAX(?v) AS ?max) WHERE { GRAPH ?g { ?r a sphn:Drug ; sphn:hasQuantity ?q . ?q sphn:hasValue ?v ; sphn:hasUnit/sphn:hasCode ?u . ?u a ucum:Gy . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX ucum: <https://biomedit.ch/rdf/sphn-resource/ucum/>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (ROUND(10 * AVG(?v)) / 10 AS ?avg) (MIN(?v) AS ?min) (MAX(?v) AS ?max) WHERE { GRAPH ?g { ?r a sphn:Drug ; sphn:hasQuantity ?q . ?q sphn:hasValue ?v ; sphn:hasUnit/sphn:hasCode ?u . ?u a ucum:Gy . } }
