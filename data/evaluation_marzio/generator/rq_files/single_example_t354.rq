# question: give me every single record for male blood cancer with exact dates please
# expected_compliant: false
# expected_rules: not_aggregated
# origin: train
# notes: SELECT ?when ?date WHERE { GRAPH ?g { ?r a sphn:OncologyDiagnosis ; sphn:hasCode ?r_c . ?r_c isa icd-10-gm:C60-C63 . ?r sphn:hasRecordDateTime ?date . ?r sphn:hasIncidenceDateTime ?when . } } ORDER BY ?when
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?when ?date WHERE { GRAPH ?g { ?r a sphn:OncologyDiagnosis ; sphn:hasCode ?r_c . ?r_c rdf:type icd-10-gm:C60-C63 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?r sphn:hasRecordDateTime ?date . ?r sphn:hasIncidenceDateTime ?when . } } ORDER BY ?when
