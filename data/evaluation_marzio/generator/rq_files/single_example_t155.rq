# question: Für die Expositionsaufzeichnungen bitten wir um die Berechnung der durchschnittlichen, minimalen und maximalen Dauer in Tagen zwischen dem Start- und dem Enddatum. Diese metrischen Kennzahlen sind für unsere epidemiologische Analyse der Behandlungsdauer von entscheidender Bedeutung.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?r) AS ?records) (COUNT(DISTINCT ?g) AS ?patients) (ROUND(AVG(?d)) AS ?avg_days) (MIN(?d) AS ?min_days) (MAX(?d) AS ?max_days) WHERE { GRAPH ?g { ?r a sphn:Exposure . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . } FILTER(?end >= ?start) BIND(bif:datediff("day", ?start, ?end) AS ?d) }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX bif: <bif:>
SELECT (COUNT(DISTINCT ?r) AS ?records) (COUNT(DISTINCT ?g) AS ?patients) (ROUND(AVG(?d)) AS ?avg_days) (MIN(?d) AS ?min_days) (MAX(?d) AS ?max_days) WHERE { GRAPH ?g { ?r a sphn:Exposure . ?r sphn:hasStartDateTime ?start ; sphn:hasEndDateTime ?end . } FILTER(?end >= ?start) BIND(bif:datediff("day", ?start, ?end) AS ?d) }
