# question: can you count how many records patient 66957 has for blood cancer evaluation or right lymph node count
# expected_compliant: false
# expected_rules: single_patient
# origin: train
# notes: SELECT (COUNT(DISTINCT ?b) AS ?records) WHERE { GRAPH <http://example.org/graph/patient-66957> { ?b a sphn:AssessmentComponent ; sphn:hasCode ?b_c . { ?b_c isa snomed:1256005000 } UNION { ?b_c isa snomed:409718002 } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?b) AS ?records) WHERE { GRAPH <http://example.org/graph/patient-66957> { ?b a sphn:AssessmentComponent ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:1256005000 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:409718002 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } }
