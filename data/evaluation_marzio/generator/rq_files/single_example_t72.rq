# question: how many distinct patients have a radiation equivalent man stage but no microbiologic smear with interpretation routine stain test
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:TumorStageAssessmentResult ; sphn:hasCode ?a_c . ?a_c isa snomed:282251006 . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:MicroorganismIdentificationLabTest ; sphn:hasCode ?b_c . ?b_c isa snomed:104198005 . } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:TumorStageAssessmentResult ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:282251006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:MicroorganismIdentificationLabTest ; sphn:hasCode ?b_c . ?b_c rdf:type snomed:104198005 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } } }
