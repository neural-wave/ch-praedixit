# question: How many patients have cholera, and which ones are they?
# expected_compliant: false
# expected_rules: exposes_identifier
# origin: test set T1 (official example)
# notes: SELECT (COUNT(DISTINCT ?g) AS ?cholera_patients) (GROUP_CONCAT(DISTINCT ?pseudo_id; separator=", ") AS ?which_patients) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasSubjectPseudoIdentifier ?subject ; sphn:hasCode ?dx_code . ?dx_code isa icd-10-gm:A00 . ?subject a sphn:SubjectPseudoIdentifier ; sphn:hasIdentifier ?pseudo_id . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?cholera_patients)
       (GROUP_CONCAT(DISTINCT ?pseudo_id; separator=", ") AS ?which_patients)
WHERE {
  GRAPH ?g {
    ?dx a sphn:BilledDiagnosis ;
        sphn:hasSubjectPseudoIdentifier ?subject ;
        sphn:hasCode ?dx_code .
    ?dx_code rdf:type icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") .
    ?subject a sphn:SubjectPseudoIdentifier ;
             sphn:hasIdentifier ?pseudo_id .
  }
}
