# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) (SAMPLE(?g) AS ?example_patient) WHERE { GRAPH ?g { ?r a sphn:Transplant ; sphn:hasGraftTypeCode ?v_c . ?v_c a ?v . } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (SAMPLE(?g) AS ?example_patient) WHERE { GRAPH ?g { ?r a sphn:Transplant ; sphn:hasGraftTypeCode ?v_c . ?v_c a ?v . } }
