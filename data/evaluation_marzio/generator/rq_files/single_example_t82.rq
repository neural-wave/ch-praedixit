# question: Count patients with intermittent dialysis who do not have strain or therapy range comments.
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:OrganSupport ; sphn:hasCode ?a_c . ?a_c isa snomed:238321006 . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:ReferenceInterpretationResult ; sphn:hasCode ?b_c . { ?b_c isa snomed:260417008 } UNION { ?b_c isa snomed:281299008 } } } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?a a sphn:OrganSupport ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:238321006 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } FILTER NOT EXISTS { GRAPH ?g { ?b a sphn:ReferenceInterpretationResult ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:260417008 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:281299008 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } } }
