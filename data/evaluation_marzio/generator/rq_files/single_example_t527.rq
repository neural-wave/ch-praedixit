# question: I am a clinician treating patients with blood cancer and I want to understand how often patients who have a resuscitation directive—whether it is a directive for CPR, a directive for resuscitation, or a directive that says not for CPR—also receive a liver transplant from a cadaver donor. Please give me the total number of patients with any of those resuscitation directives, the number of those patients who also have at least one cadaver liver transplant, and the percentage of the first group that also received the transplant.
# expected_compliant: true
# expected_rules: none
# origin: test set T3 (worded by the other model)
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients_b) (COUNT(DISTINCT ?ab) AS ?patients_a_and_b) (ROUND(1000.0 * COUNT(DISTINCT ?ab) / COUNT(DISTINCT ?g)) / 10 AS ?pct) WHERE { GRAPH ?g { ?b a sphn:ResuscitationDirective ; sphn:hasCode ?b_c . { ?b_c isa snomed:450475007 } UNION { ?b_c isa snomed:304252001 } UNION { ?b_c isa snomed:450476008 } } OPTIONAL { GRAPH ?g { ?a a sphn:Transplant ; sphn:hasCode ?a_c . ?a_c isa snomed:421423009 . } BIND(?g AS ?ab) } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients_b) (COUNT(DISTINCT ?ab) AS ?patients_a_and_b) (ROUND(1000.0 * COUNT(DISTINCT ?ab) / COUNT(DISTINCT ?g)) / 10 AS ?pct) WHERE { GRAPH ?g { ?b a sphn:ResuscitationDirective ; sphn:hasCode ?b_c . { ?b_c rdf:type snomed:450475007 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:304252001 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?b_c rdf:type snomed:450476008 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } OPTIONAL { GRAPH ?g { ?a a sphn:Transplant ; sphn:hasCode ?a_c . ?a_c rdf:type snomed:421423009 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } BIND(?g AS ?ab) } }
