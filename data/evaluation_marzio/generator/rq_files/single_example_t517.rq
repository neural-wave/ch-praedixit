# question: Count adverse evnt consequences and distinct patients.
# expected_compliant: true
# expected_rules: none
# origin: test set T2 (held-out concept)
# notes: SELECT ?value (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:AdverseEvent ; sphn:hasConsequences ?v . } BIND(STRAFTER(STR(?v), "#") AS ?value) } GROUP BY ?value ORDER BY DESC(?records)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?value (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?r) AS ?records) WHERE { GRAPH ?g { ?r a sphn:AdverseEvent ; sphn:hasConsequences ?v . } BIND(STRAFTER(STR(?v), "#") AS ?value) } GROUP BY ?value ORDER BY DESC(?records)
