# question: Können Sie bitte die Anzahl der Patienten mit den ICD-10-Codes K20-K31 (Ösophagus, Magen und Duodenum), G40-G47 (Episodische und paroxysmale Krankheiten des Nervensystems) oder J40-J47 (Chronische Krankheiten der unteren Atemwege) ermitteln, bei denen diese Diagnoseen als Primärdiagnose kodiert sind, sowie den prozentualen Anteil dieser Patienten an der Gesamtheit der mit diesen Diagnosen behandelten Fälle?
# expected_compliant: true
# expected_rules: none
# origin: train
# notes: SELECT (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?principal) AS ?patients_principal) (ROUND(1000.0 * COUNT(DISTINCT ?principal) / COUNT(DISTINCT ?g)) / 10 AS ?principal_pct) WHERE { GRAPH ?g { ?r a sphn:BilledDiagnosis ; sphn:hasCode ?r_c . { ?r_c isa icd-10-gm:K20-K31 } UNION { ?r_c isa icd-10-gm:G40-G47 } UNION { ?r_c isa icd-10-gm:J40-J47 } } OPTIONAL { GRAPH ?g { ?r sphn:hasRank sphn-individual:Principal . } BIND(?g AS ?principal) } }
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) (COUNT(DISTINCT ?principal) AS ?patients_principal) (ROUND(1000.0 * COUNT(DISTINCT ?principal) / COUNT(DISTINCT ?g)) / 10 AS ?principal_pct) WHERE { GRAPH ?g { ?r a sphn:BilledDiagnosis ; sphn:hasCode ?r_c . { ?r_c rdf:type icd-10-gm:K20-K31 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type icd-10-gm:G40-G47 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } UNION { ?r_c rdf:type icd-10-gm:J40-J47 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") } } OPTIONAL { GRAPH ?g { ?r sphn:hasRank sphn-individual:Principal . } BIND(?g AS ?principal) } }
