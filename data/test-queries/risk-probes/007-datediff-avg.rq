# question: What is the average length of a hospital stay in days?
# source: compliance/tests/test_risk_probes.py::test_default_mode[datediff_avg]
# description: bif:datediff average length of stay
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (AVG(bif:datediff("day", ?in, ?out)) AS ?los) WHERE { GRAPH ?g { ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?in ; sphn:hasDischargeDateTime ?out . } }
