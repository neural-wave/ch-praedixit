# question: List each patient with type 2 diabetes and how many such diagnoses they have.
# source: compliance/tests/test_risk_probes.py::test_default_mode[replace_graph_id]
# description: identifier smuggled through REPLACE
# expected_compliant: false
# expected_rules: QC5 (exposes_identifier)
# reasoning: groups by identifier ?pid
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT ?pid (COUNT(?dx) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } BIND(REPLACE(STR(?g), "^.*/", "") AS ?pid) } GROUP BY ?pid
