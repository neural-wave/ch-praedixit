# question: How many patients have had an oncology surgery or a radiotherapy procedure?
# source: compliance/tests/test_risk_probes.py::test_default_mode[union_two_classes]
# description: patients with either of two record types
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { { ?x a sphn:OncologySurgery } UNION { ?x a sphn:RadiotherapyProcedure } } }
