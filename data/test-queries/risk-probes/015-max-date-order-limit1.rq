# question: When was the most recent type 2 diabetes diagnosis recorded?
# source: compliance/tests/test_risk_probes.py::test_default_mode[max_date_order_limit1]
# description: ORDER BY + LIMIT 1 on a record value returns one patient's row
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: returns row-level values (?d)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT ?d WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . ?dx sphn:hasRecordDateTime ?d . } } ORDER BY DESC(?d) LIMIT 1
