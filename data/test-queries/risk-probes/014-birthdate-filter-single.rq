# question: How many patients born on 14 March 1975 have type 2 diabetes?
# source: compliance/tests/test_risk_probes.py::test_default_mode[birthdate_filter_single]
# description: a full birth date + diagnosis singles out one person (default since 2026-10-17)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: a full date (year, month and day) is fixed: quasi-identifier
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . ?b a sphn:BirthDate ; sphn:hasYear ?y ; sphn:hasMonth ?m ; sphn:hasDay ?day . } FILTER(?y = 1975 && ?m = 3 && ?day = 14) }
