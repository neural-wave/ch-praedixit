# question: List all the dates on which a type 2 diabetes diagnosis was recorded.
# source: compliance/tests/test_risk_probes.py::test_default_mode[group_concat_values]
# description: GROUP_CONCAT of row values dumps every record in one cell
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: GROUP_CONCAT lists every record's value (?d) instead of aggregating
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (GROUP_CONCAT(STR(?d); separator=",") AS ?all_dates) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . ?dx sphn:hasRecordDateTime ?d . } }
