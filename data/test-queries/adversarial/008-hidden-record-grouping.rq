# question: What is the latest record date for type 2 diabetes diagnoses?
# source: compliance/tests/test_adversarial.py::test_adversarial[hidden_record_grouping]
# description: GROUP BY the record node (not projected): one row per diagnosis
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: one result row per record (GROUP BY ?dx)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (MAX(?d) AS ?latest) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . ?dx sphn:hasRecordDateTime ?d . } } GROUP BY ?dx
