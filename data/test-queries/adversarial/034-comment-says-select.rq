# question: Describe every type 2 diabetes diagnosis.
# source: compliance/tests/test_adversarial.py::test_adversarial[comment_says_select]
# description: a comment contains SELECT; the query is DESCRIBE
# expected_compliant: false
# expected_rules: QC4 (not_select)
# reasoning: DESCRIBE query
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
# SELECT (COUNT(DISTINCT ?g) AS ?n)
DESCRIBE ?dx WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } }
