# question: How many type 2 diabetes diagnoses belong to case ID-10000010000001?
# source: compliance/tests/test_adversarial.py::test_adversarial[identifier_via_path_constant]
# description: case identifier fixed through a property path
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: identifier fixed to rdflib.term.Literal('ID-10000010000001')
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(?dx) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . ?dx sphn:hasAdministrativeCase/sphn:hasIdentifier "ID-10000010000001" . } }
