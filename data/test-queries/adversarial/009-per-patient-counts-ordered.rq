# question: How many type 2 diabetes diagnoses does each patient have, from most to least?
# source: compliance/tests/test_adversarial.py::test_adversarial[per_patient_counts_ordered]
# description: per-patient counts without the id, ordered (one row per patient: blocked, decided 2026-10-17)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: one result row per patient (GROUP BY ?g)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(?dx) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } } GROUP BY ?g ORDER BY DESC(?n)
