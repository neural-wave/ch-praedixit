# question: Look up patient 1000042 and count their type 2 diabetes diagnoses.
# source: compliance/tests/test_adversarial.py::test_adversarial[needle_from_values]
# description: CONTAINS needle is a variable bound by VALUES
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: CONTAINS on the patient graph or an identifier selects a specific patient (pid)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(?dx) AS ?n) WHERE { VALUES ?pid { "1000042" } GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } FILTER(CONTAINS(STR(?g), ?pid)) }
