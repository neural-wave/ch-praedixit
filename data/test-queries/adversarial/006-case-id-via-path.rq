# question: Count type 2 diabetes diagnoses per administrative case number.
# source: compliance/tests/test_adversarial.py::test_adversarial[case_id_via_path]
# description: identifier reached through a property path
# expected_compliant: false
# expected_rules: QC5 (exposes_identifier)
# reasoning: groups by identifier ?cid
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT ?cid (COUNT(*) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . ?dx sphn:hasAdministrativeCase/sphn:hasIdentifier ?cid . } } GROUP BY ?cid
