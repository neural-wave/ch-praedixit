# question: How many patients have type 1 or type 2 diabetes, by type?
# source: compliance/tests/test_adversarial.py::test_adversarial[decoy_values_codes]
# description: VALUES list of code classes (constants, but not patients)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT ?cls (COUNT(DISTINCT ?g) AS ?n) WHERE { VALUES ?cls { icd-10-gm:E11 icd-10-gm:E10 } GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?k . ?k a ?cls . } } GROUP BY ?cls
