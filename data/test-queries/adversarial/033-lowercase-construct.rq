# question: Export the type 2 diabetes diagnoses as a graph.
# source: compliance/tests/test_adversarial.py::test_adversarial[lowercase_construct]
# description: lower-case keyword
# expected_compliant: false
# expected_rules: QC4 (not_select)
# reasoning: CONSTRUCT query
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
construct { ?dx a sphn:BilledDiagnosis } where { graph ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } }
