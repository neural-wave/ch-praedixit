# question: Count type 2 diabetes diagnoses using the external endpoint.
# source: compliance/tests/test_adversarial.py::test_adversarial[service_variable]
# description: federated call to an endpoint chosen at runtime
# expected_compliant: false
# expected_rules: QC3 (unrestricted_match)
# reasoning: federated SERVICE call
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(*) AS ?n) WHERE { VALUES ?ep { <http://example.org/sparql> } SERVICE ?ep { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } }
