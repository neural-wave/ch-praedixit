# question: For each patient, how many cholera diagnoses do they have?
# source: compliance/tests/test_rules.py::test_case[per_patient_counts_hidden]
# description: case (per_patient_counts_hidden)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: one result row per patient (GROUP BY ?g)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(?dx) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } } GROUP BY ?g
