# question: How many billed cholera diagnoses does the external endpoint have?
# source: compliance/tests/test_rules.py::test_case[service]
# description: case (service)
# expected_compliant: false
# expected_rules: QC3 (unrestricted_match)
# reasoning: federated SERVICE call
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(*) AS ?n) WHERE { SERVICE <http://x.org/sparql> { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
