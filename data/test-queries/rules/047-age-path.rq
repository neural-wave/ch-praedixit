# question: How many patients with a billed diagnosis are there at each exact age?
# source: compliance/tests/test_rules.py::test_group_by_raw_fine_value_is_row_level[age_path]
# description: group by raw fine value is row level (age_path)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: groups by the exact measurement value ?age: almost every group is one record, so the result is row-level data (group by a range instead, e.g. YEAR() or FLOOR())
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?age (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasSubjectAge/sphn:hasQuantity/sphn:hasValue ?age . } } GROUP BY ?age
