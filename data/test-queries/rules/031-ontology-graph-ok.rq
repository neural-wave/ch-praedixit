# question: How many patients have cholera or any of its subtypes?
# source: compliance/tests/test_rules.py::test_case[ontology_graph_ok]
# description: case (ontology_graph_ok)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?dx_code a ?c . } GRAPH <https://biomedit.ch/rdf/sphn-resource/global> { ?c rdfs:subClassOf* icd-10-gm:A00 } }
