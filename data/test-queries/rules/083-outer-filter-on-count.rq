# question: How many diagnosis codes are held by 5 patients or fewer?
# source: compliance/tests/test_rules.py::test_small_cells_rewritten[outer_filter_on_count]
# description: small cells rewritten (outer_filter_on_count)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: HAVING keeps only groups of at most 5 (small cells): each result row points at a handful of patients
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(*) AS ?rare) WHERE { { SELECT ?cls (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a ?cls . } } GROUP BY ?cls } FILTER(?n <= 5) }
