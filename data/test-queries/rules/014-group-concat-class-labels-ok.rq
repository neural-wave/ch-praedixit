# question: How many patients have each diagnosis code?
# source: compliance/tests/test_rules.py::test_case[group_concat_class_labels_ok]
# description: case (group_concat_class_labels_ok)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?c (GROUP_CONCAT(DISTINCT ?c; separator=",") AS ?codes) (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?k . ?k a ?c . } } GROUP BY ?c
