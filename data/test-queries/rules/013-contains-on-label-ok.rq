# question: How many patients have a diagnosis whose name contains 'diabetes'?
# source: compliance/tests/test_rules.py::test_case[contains_on_label_ok]
# description: case (contains_on_label_ok)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?k . ?k a ?c . } GRAPH <https://biomedit.ch/rdf/sphn-resource/global> { ?c rdfs:label ?l } FILTER(CONTAINS(LCASE(?l), "diabetes")) }
