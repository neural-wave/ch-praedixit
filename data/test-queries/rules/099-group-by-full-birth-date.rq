# question: How many patients were born on each exact date?
# source: compliance/tests/test_rules.py::test_unnamed_group_keys_and_wrapped_qi[group_by_full_birth_date]
# description: unnamed group keys and wrapped qi (group_by_full_birth_date)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: groups by the exact date (year, month and day) ?d: almost every group is one record, so the result is row-level data (group by a range instead, e.g. YEAR() or FLOOR())
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?y ?m ?d (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?b a sphn:BirthDate ; sphn:hasYear ?y ; sphn:hasMonth ?m ; sphn:hasDay ?d } } GROUP BY ?y ?m ?d
