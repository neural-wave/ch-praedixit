# question: List all billed cholera diagnosis records.
# source: compliance/tests/test_rules.py::test_case[record_iri_row]
# description: case (record_iri_row)
# expected_compliant: false
# expected_rules: QC5 (exposes_identifier)
# reasoning: returns identifier ?dx
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?dx WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
