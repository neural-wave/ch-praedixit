# question: How many patients were admitted on 12 February 2024?
# source: compliance/tests/test_rules.py::test_exact_timestamp_or_full_date_rewritten[strstarts_day]
# description: exact timestamp or full date rewritten (strstarts_day)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: FILTER fixes a full date of ?a (year, month and day): quasi-identifier
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?a . } FILTER(STRSTARTS(STR(?a), "2024-02-12")) }
