# question: How many patients were admitted at each exact date and time?
# source: compliance/tests/test_rules.py::test_unnamed_group_keys_and_wrapped_qi[unnamed_group_by_datetime]
# description: unnamed group keys and wrapped qi (unnamed_group_by_datetime)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: groups by the exact date-time ?a: almost every group is one record, so the result is row-level data (group by a range instead, e.g. YEAR() or FLOOR())
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?a . } } GROUP BY (?a)
