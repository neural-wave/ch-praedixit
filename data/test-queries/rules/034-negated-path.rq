# question: How many statements in the patient data are not type statements?
# source: compliance/tests/test_rules.py::test_case[negated_path]
# description: case (negated_path)
# expected_compliant: false
# expected_rules: QC3 (unrestricted_match)
# reasoning: pattern not tied to any class or property restriction (?s Path(! http://www.w3.org/1999/02/22-rdf-syntax-ns#type) ?o)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(*) AS ?n) WHERE { GRAPH ?g { ?s !rdf:type ?o } }
