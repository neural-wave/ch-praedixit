# question: How many patients had a diagnosis recorded at each exact date and time?
# source: compliance/tests/test_rules.py::test_group_by_raw_fine_value_is_row_level[datetime]
# description: group by raw fine value is row level (datetime)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: groups by the exact date-time ?d: almost every group is one record, so the result is row-level data (group by a range instead, e.g. YEAR() or FLOOR())
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?d (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasRecordDateTime ?d ; sphn:hasCode ?c . ?c a ?cls . } } GROUP BY ?d
