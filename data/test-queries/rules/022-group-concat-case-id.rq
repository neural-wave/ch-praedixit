# question: List the IDs of the hospital cases with a cholera diagnosis.
# source: compliance/tests/test_rules.py::test_case[group_concat_case_id]
# description: case (group_concat_case_id)
# expected_compliant: false
# expected_rules: QC5 (exposes_identifier)
# reasoning: GROUPCONCAT over identifier ?id
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (GROUP_CONCAT(?id) AS ?ids) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?dx sphn:hasAdministrativeCase ?c . ?c sphn:hasIdentifier ?id . } }
