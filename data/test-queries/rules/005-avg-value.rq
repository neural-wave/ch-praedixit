# question: What is the average body mass index?
# source: compliance/tests/test_rules.py::test_case[avg_value]
# description: case (avg_value)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (AVG(?v) AS ?avg) WHERE { GRAPH ?g { ?m a sphn:BodyMassIndex ; sphn:hasQuantity/sphn:hasValue ?v . } }
