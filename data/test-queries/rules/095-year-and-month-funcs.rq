# question: How many patients were admitted in February 2024?
# source: compliance/tests/test_rules.py::test_month_granularity_stays_compliant[year_and_month_funcs]
# description: month granularity stays compliant (year_and_month_funcs)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?a . } FILTER(YEAR(?a) = 2024 && MONTH(?a) = 2) }
