# question: How many cholera diagnoses does patient p-1 have?
# source: compliance/tests/test_rules.py::test_case[str_g_equals_literal]
# description: case (str_g_equals_literal)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: FILTER compares the patient graph or an identifier (?g) to a constant
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(*) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } FILTER(STR(?g) = "http://example.org/graph/p-1") }
