# question: How many patients of nationality 223369002 with type 2 diabetes are there per sex and birth year?
# source: compliance/tests/test_rules.py::test_fewer_or_unfixed_quasi_identifiers_stay_compliant[grouped_not_fixed]
# description: fewer or unfixed quasi identifiers stay compliant (grouped_not_fixed)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?sex ?y (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/E11> . ?s a sphn:AdministrativeSex ; sphn:hasCode ?sc . ?sc a ?sex . ?n a sphn:Nationality ; sphn:hasAssociatedCountry/sphn:hasCode ?nc . ?nc a <http://snomed.info/id/223369002> . ?b a sphn:BirthDate ; sphn:hasYear ?y . } } GROUP BY ?sex ?y
