# question: What is the average length of a hospital stay in days?
# source: compliance/tests/test_rules.py::test_case[bif_undeclared_ok]
# description: case (bif_undeclared_ok)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (AVG(bif:datediff("day", ?a, ?b)) AS ?los) WHERE { GRAPH ?g { ?c a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?a ; sphn:hasDischargeDateTime ?b } }
