# question: Describe every billed cholera diagnosis.
# source: compliance/tests/test_rules.py::test_case[describe]
# description: case (describe)
# expected_compliant: false
# expected_rules: QC4 (not_select)
# reasoning: DESCRIBE query
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
DESCRIBE ?dx WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
