# question: How many cholera diagnoses does the patient with ID ID-42 have?
# source: compliance/tests/test_rules.py::test_case[identifier_literal]
# description: case (identifier_literal)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: identifier fixed to rdflib.term.Literal('ID-42')
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(*) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?dx sphn:hasSubjectPseudoIdentifier ?s . ?s sphn:hasIdentifier "ID-42" . } }
