# question: How many patients were admitted on 12 February 2024?
# source: compliance/tests/test_rules.py::test_exact_timestamp_or_full_date_rewritten[xsd_date_cast]
# description: exact timestamp or full date rewritten (xsd_date_cast)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: FILTER fixes an exact timestamp (?a): quasi-identifier
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?a . } FILTER(xsd:date(?a) = "2024-02-12"^^xsd:date) }
