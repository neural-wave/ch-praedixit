# question: Show me ten dates on which a cholera diagnosis was recorded.
# source: compliance/tests/test_rules.py::test_case[distinct_rows_with_limit]
# description: case (distinct_rows_with_limit)
# expected_compliant: false
# expected_rules: QC2 (not_aggregated)
# reasoning: returns row-level values (?d)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT DISTINCT ?d WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . ?dx sphn:hasRecordDateTime ?d . } } LIMIT 10
