# question: How many patients had a diagnosis recorded, per year?
# source: compliance/tests/test_rules.py::test_binned_or_aggregated_values_stay_compliant[year]
# description: binned or aggregated values stay compliant (year)
# expected_compliant: true
# expected_rules: none
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?year (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasRecordDateTime ?d ; sphn:hasCode ?c . ?c a ?cls . } BIND(YEAR(?d) AS ?year) } GROUP BY ?year
