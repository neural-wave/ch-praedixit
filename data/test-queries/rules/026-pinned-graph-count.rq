# question: How many cholera diagnoses does patient p-1 have?
# source: compliance/tests/test_rules.py::test_case[pinned_graph_count]
# description: case (pinned_graph_count)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: GRAPH pinned to <http://example.org/graph/p-1>
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(*) AS ?n) WHERE { GRAPH <http://example.org/graph/p-1> { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?dx_code .
?dx_code a icd-10-gm:A00 OPTION (inference "https://biomedit.ch/rdf/sphn-resource/global") . } }
