# question: How many patients were born on 14 March 1975?
# source: compliance/tests/test_rules.py::test_exact_timestamp_or_full_date_rewritten[str_birth_parts]
# description: exact timestamp or full date rewritten (str_birth_parts)
# expected_compliant: false
# expected_rules: QC1 (single_patient)
# reasoning: a full date (year, month and day) is fixed: quasi-identifier
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?b a sphn:BirthDate ; sphn:hasYear ?y ; sphn:hasMonth ?m ; sphn:hasDay ?d } FILTER(STR(?y) = "1975" && STR(?m) = "--03" && STR(?d) = "---14") }
