# question: How many type 2 diabetes diagnoses does each patient have, from most to least?
# expected_compliant: false
# expected_rules: not_aggregated
# origin: adversarial
# notes: row-level, per_patient_counts_ordered: per-patient counts without the id, ordered
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(?dx) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } } GROUP BY ?g ORDER BY DESC(?n)
