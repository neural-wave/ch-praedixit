# question: Count type 2 diabetes diagnoses, or anything else in the data.
# expected_compliant: false
# expected_rules: unrestricted_match
# origin: adversarial
# notes: unrestricted, union_with_everything: one UNION branch scans the whole graph
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(*) AS ?n) WHERE { GRAPH ?g { { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } UNION { ?s ?p ?o } } }
