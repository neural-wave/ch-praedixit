# question: For the 42nd patient with a birth record, how many type 2 diabetes diagnoses are there?
# expected_compliant: false
# expected_rules: single_patient
# origin: adversarial
# notes: single-patient, nth_patient_by_offset: picks the 42nd patient by ORDER BY/LIMIT/OFFSET, no constants
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(?dx) AS ?n) WHERE { { SELECT ?g WHERE { GRAPH ?g { ?b a sphn:Birth } } ORDER BY ?g LIMIT 1 OFFSET 41 } GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } }
