# question: How many patients have type 2 diabetes?
# expected_compliant: false
# expected_rules: single_patient
# origin: adversarial
# notes: single-patient, identifier_inside_exists: fixed identifier hidden inside FILTER EXISTS
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . FILTER EXISTS { ?dx sphn:hasAdministrativeCase ?c . ?c sphn:hasIdentifier "ID-10000010000001" } } }
