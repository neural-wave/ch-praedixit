# question: How much data is there in total?
# expected_compliant: false
# expected_rules: unrestricted_match
# origin: bypass
# notes: The alternative path covers every predicate.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT (COUNT(*) AS ?triples)
WHERE {
  GRAPH ?g { ?s (rdf:type|!rdf:type) ?o . }
}
