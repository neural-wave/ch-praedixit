# question: How many type 2 diabetes diagnoses does patient 1000042 have?
# expected_compliant: false
# expected_rules: single_patient
# origin: adversarial
# notes: single-patient, bind_graph_constant: graph IRI introduced through BIND, then used as GRAPH ?t
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(?dx) AS ?n) WHERE { BIND(<http://example.org/graph/gen_mock_data-1_1000042> AS ?t) GRAPH ?t { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } }
