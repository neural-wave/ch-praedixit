# question: How long do hospital stays last on average, and how many last more than 30 days?
# expected_compliant: true
# expected_rules: none
# origin: test set
# notes: Schema 2026.1 form: admission and discharge are separate nodes (sphn:hasAdmission, sphn:hasDischarge) with sphn:hasDateTime. The mock data uses sphn:hasAdmissionDateTime and sphn:hasDischargeDateTime (schema 2024.2), so this query returns no rows locally.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX bif: <bif:>

SELECT (COUNT(?case) AS ?stays)
       (ROUND(AVG(?days)) AS ?avg_length_of_stay_days)
       (SUM(IF(?days > 30, 1, 0)) AS ?stays_longer_than_30_days)
WHERE {
  GRAPH ?g {
    ?case a sphn:AdministrativeCase ;
          sphn:hasAdmission ?admission ;
          sphn:hasDischarge ?discharge .
    ?admission sphn:hasDateTime ?admission_time .
    ?discharge sphn:hasDateTime ?discharge_time .
  }
  FILTER (?discharge_time >= ?admission_time)
  BIND (bif:datediff("day", ?admission_time, ?discharge_time) AS ?days)
}
