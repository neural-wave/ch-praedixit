# question: How many patients other than patient 1000042 have type 2 diabetes?
# expected_compliant: false
# expected_rules: single_patient
# origin: adversarial
# notes: single-patient, differencing_complement: all-but-one count: subtracted from the full count, it reveals whether patient 1000042 has the diagnosis, so the query is about one identifiable patient
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?c . ?c a icd-10-gm:E11 . } FILTER(?g != <http://example.org/graph/gen_mock_data-1_1000042>) }
