# question: How many patients are there for each sex and year of birth?
# expected_compliant: true
# expected_rules: none
# origin: bypass
# notes: Allowed by RULES.md as written: identifying attributes grouped, not fixed.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>

SELECT ?sex ?year (COUNT(DISTINCT ?g) AS ?patients)
WHERE {
  GRAPH ?g {
    ?sex_record a sphn:AdministrativeSex ; sphn:hasCode ?sex_code . ?sex_code a ?sex .
    ?birth_date a sphn:BirthDate ; sphn:hasYear ?year .
  }
}
GROUP BY ?sex ?year
