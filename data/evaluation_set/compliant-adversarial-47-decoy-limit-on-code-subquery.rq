# question: How many patients have one of the five most common diagnosis codes?
# expected_compliant: true
# expected_rules: none
# origin: adversarial
# notes: decoy, decoy_limit_on_code_subquery: LIMIT in a subquery over code classes, not patients
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX sphn-individual: <https://biomedit.ch/rdf/sphn-schema/sphn/individual#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
PREFIX bif: <bif:>
SELECT (COUNT(DISTINCT ?g) AS ?n) WHERE { { SELECT ?cls WHERE { GRAPH ?h { ?k a ?cls . ?d sphn:hasCode ?k } } GROUP BY ?cls ORDER BY DESC(COUNT(?k)) LIMIT 5 } GRAPH ?g { ?dx a sphn:BilledDiagnosis ; sphn:hasCode ?k2 . ?k2 a ?cls . } }
