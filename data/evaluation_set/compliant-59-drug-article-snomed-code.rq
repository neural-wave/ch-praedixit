# question: How many patients have a drug article with code 248153007?
# expected_compliant: true
# expected_rules: none
# origin: bypass
# notes: Equality with a plain code (no ID- prefix) is a shared code, even if it is all digits.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>

SELECT (COUNT(DISTINCT ?g) AS ?patients)
WHERE {
  GRAPH ?g { ?article a sphn:DrugArticle ; sphn:hasCode ?code . ?code sphn:hasIdentifier ?code_id . }
  FILTER (?code_id = "248153007")
}
