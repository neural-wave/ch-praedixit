# question: How many billed diagnoses does patient 0042 have?
# expected_compliant: false
# expected_rules: single_patient
# origin: bypass
# notes: FILTER with CONTAINS on the graph IRI, a natural translation of 'patient 0042'.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>

SELECT (COUNT(?diagnosis) AS ?billed_diagnoses)
WHERE {
  GRAPH ?g { ?diagnosis a sphn:BilledDiagnosis . }
  FILTER (CONTAINS(STR(?g), "0042"))
}
