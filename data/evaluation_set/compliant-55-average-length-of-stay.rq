# question: What is the average length of stay in days?
# expected_compliant: true
# expected_rules: none
# origin: bypass
# notes: bif:datediff in days between two record values, averaged: no constant date.
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>

SELECT (AVG(bif:datediff("day", ?admission, ?discharge)) AS ?days)
WHERE {
  GRAPH ?g {
    ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?admission ; sphn:hasDischargeDateTime ?discharge .
  }
}
