# why: the birth year as a range
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX snomed: <http://snomed.info/id/>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?sex a sphn:AdministrativeSex ; sphn:hasCode ?sex_code . ?sex_code a snomed:248152002 . ?nationality a sphn:Nationality ; sphn:hasAssociatedCountry/sphn:hasCode ?country . ?country a snomed:223369002 . ?birth_date a sphn:BirthDate ; sphn:hasYear ?year . } FILTER (?year >= 1970 && ?year < 1980) }
