# why: code identifiers without a restricted coding system are mostly per-patient
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT ?code_id (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?article a sphn:DrugArticle ; sphn:hasCode ?article_code . ?article_code sphn:hasIdentifier ?code_id . } } GROUP BY ?code_id
