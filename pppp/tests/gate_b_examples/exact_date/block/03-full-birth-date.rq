# why: year, month and day of a birth date
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?birth_date a sphn:BirthDate ; sphn:hasYear ?year ; sphn:hasMonth ?month ; sphn:hasDay ?day . } FILTER (?year = 1975 && ?month = 3 && ?day = 14) }
