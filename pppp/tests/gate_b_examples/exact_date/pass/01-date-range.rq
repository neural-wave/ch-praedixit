# why: a range of dates
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?case a sphn:AdministrativeCase ; sphn:hasAdmissionDateTime ?admission . } FILTER (?admission >= "2024-01-01T00:00:00"^^xsd:dateTime && ?admission < "2025-01-01T00:00:00"^^xsd:dateTime) }
