# why: one row per patient, even without the graph IRI
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (COUNT(?diagnosis) AS ?diagnoses) WHERE { GRAPH ?g { ?diagnosis a sphn:BilledDiagnosis ; sphn:hasCode ?code . ?code a icd-10-gm:E11 . } } GROUP BY ?g
