# why: per-patient counts in a subquery, averaged outside
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT (AVG(?diagnoses) AS ?per_patient) WHERE { { SELECT ?g (COUNT(?diagnosis) AS ?diagnoses) WHERE { GRAPH ?g { ?diagnosis a sphn:BilledDiagnosis ; sphn:hasCode ?code . ?code a icd-10-gm:E11 . } } GROUP BY ?g } }
