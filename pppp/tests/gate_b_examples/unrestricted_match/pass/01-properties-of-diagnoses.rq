# why: ?p and ?o are tied to a restricted record (?diagnosis)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
PREFIX icd-10-gm: <https://biomedit.ch/rdf/sphn-resource/icd-10-gm/>
SELECT ?property (COUNT(*) AS ?uses) WHERE { GRAPH ?g { ?diagnosis a sphn:BilledDiagnosis ; sphn:hasCode ?code . ?code a icd-10-gm:E11 . ?diagnosis ?property ?value . } } GROUP BY ?property
