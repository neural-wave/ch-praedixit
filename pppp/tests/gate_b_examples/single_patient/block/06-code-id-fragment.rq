# why: a 7+ digit part of a per-patient code identifier (coding system not restricted)
PREFIX sphn: <https://biomedit.ch/rdf/sphn-schema/sphn#>
SELECT (COUNT(DISTINCT ?g) AS ?patients) WHERE { GRAPH ?g { ?article a sphn:DrugArticle ; sphn:hasCode ?article_code . ?article_code sphn:hasIdentifier ?code_id . } FILTER (CONTAINS(?code_id, "10000540000003")) }
